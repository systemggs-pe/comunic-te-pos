BACKEND_PORT=3001
# Dejar vacio para usar /api en Netlify o el proxy local de Vite.
VITE_BACKEND_BASE_URL=
FIREBASE_API_KEY=tu_firebase_web_api_key
RENIEC_TOKEN=tu_token_reniec
ALLOWED_EMAILS=brand050103@gmail.com,lauryruyz50@gmail.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://comunicate-tacna.web.app,https://comunicate-tacna.firebaseapp.com
RENIEC_TIMEOUT_MS=10000
CODART_TIMEOUT_MS=10000

# Solo servidor: nunca usar un prefijo VITE_ para la clave de Gemini.
GEMINI_API_KEY=tu_clave_gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=25000

# Solo servidor: consulta de boletas APPLE en la aplicacion/base externa.
# La URL debe apuntar al endpoint POST que busca por IMEI. Nunca usar prefijo VITE_.
APPLE_RECEIPTS_API_URL=https://comunicate-boletas.netlify.app/api/boletas
APPLE_RECEIPTS_API_KEY=tu_clave_privada_del_servicio_de_boletas
APPLE_RECEIPTS_TIMEOUT_MS=10000

# Netlify Functions escribe en Firestore con Firebase Admin SDK.
# Usa una sola de estas opciones:
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"..."}
# FIREBASE_PROJECT_ID=comunicate-tacna
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@comunicate-tacna.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
