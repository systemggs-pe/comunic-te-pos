rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // All uploads and reads are performed by Netlify Functions with Admin SDK.
    // The browser must never access evidence objects directly with client credentials.
    match /auto-registros/{submissionId}/{fileName} {
      allow read, write: if false;
    }

    match /dni-fotos/{historyId}/{fileName} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
